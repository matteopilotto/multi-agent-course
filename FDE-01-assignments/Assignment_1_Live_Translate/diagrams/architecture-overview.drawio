<mxfile host="app.diagrams.net" modified="2026-07-15T00:00:00.000Z" agent="fde-live-translate" version="24.0.0" type="device">
  <diagram id="overview" name="Live Translate — System Architecture">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== title ===== -->
        <mxCell id="title" value="Live Translate — System Architecture  ·  EN → Mexican Spanish (es-MX) widget + two-service backend on Fly.io" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="34" as="geometry" />
        </mxCell>

        <!-- ===== ZONES (behind nodes) ===== -->
        <mxCell id="z_client" value="CLIENT — the browser, on any web page  ·  frontend is PROVIDED (you build the backend)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=2;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="z_fly" value="Fly.io org  ·  multi-region: fra (EU · primary / kept warm) + iad (US-East · secondary, scales to 0)  ·  Anycast edge  ·  Docker images" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#3b5a8a;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1290" height="720" as="geometry" />
        </mxCell>
        <mxCell id="z_priv" value="🔒 Fly private network — Flycast / 6PN  ·  reachable only inside the org (browser can never touch this)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#eafaf0;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#4a7a3a;" vertex="1" parent="1">
          <mxGeometry x="520" y="345" width="770" height="650" as="geometry" />
        </mxCell>
        <mxCell id="z_ext" value="External" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=2;fontSize=13;fontColor=#6a4c93;" vertex="1" parent="1">
          <mxGeometry x="1360" y="345" width="200" height="650" as="geometry" />
        </mxCell>

        <!-- ===== CLIENT nodes ===== -->
        <mxCell id="widget" value="&lt;b&gt;🌐 Translation Widget&lt;/b&gt;&lt;br&gt;widget/translation-widget.js&lt;br&gt;&lt;i&gt;builds the UI, chunks visible&lt;br&gt;page text, calls the gateway,&lt;br&gt;shows cache-hit badges&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ext" value="&lt;b&gt;Chrome Extension (MV3)&lt;/b&gt;&lt;br&gt;content.js injects the widget&lt;br&gt;on &amp;lt;all_urls&amp;gt; (works on&lt;br&gt;strict-CSP sites); popup sets&lt;br&gt;backend URL + target language" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="console" value="&lt;b&gt;Console loader&lt;/b&gt;&lt;br&gt;loader/console-snippet.js&lt;br&gt;&lt;i&gt;paste in DevTools&lt;br&gt;(permissive pages)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="110" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="demo" value="&lt;b&gt;Demo page&lt;/b&gt;&lt;br&gt;demo-pages/index.html&lt;br&gt;&lt;i&gt;local test page&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="110" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="contract" value="&lt;b&gt;API contract (fixed — do not change)&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /translate&lt;br&gt;POST /translate/batch&lt;br&gt;GET&#160; /health&#160;&#160;&#160;GET /stats&lt;br&gt;&lt;br&gt;&lt;i&gt;same shapes browser→gateway→AI&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="110" width="300" height="130" as="geometry" />
        </mxCell>

        <!-- ===== GATEWAY (public edge) ===== -->
        <mxCell id="gw" value="&lt;b&gt;Node Gateway&lt;/b&gt;&#160;:8787&#160;&#183;&#160;Express&lt;br&gt;&lt;i&gt;matteopilotto-livetranslate-gw.fly.dev&lt;/i&gt;&lt;br&gt;&lt;br&gt;• CORS (all origins, dev)&lt;br&gt;• JSON validation → 400&lt;br&gt;• per-IP rate limit → 429&lt;br&gt;• structured request log → gateway.log&lt;br&gt;• X-Request-Id (reuse-or-generate)&lt;br&gt;• serves /widget.js · proxies to AI&lt;br&gt;&lt;br&gt;&lt;b&gt;PUBLIC — the only door in&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="360" width="360" height="270" as="geometry" />
        </mxCell>
        <mxCell id="gwlog" value="📄 gateway.log&lt;br&gt;&lt;i&gt;method · url · status · ms · requestId&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="660" width="360" height="60" as="geometry" />
        </mxCell>

        <!-- ===== AI SERVICE (private) ===== -->
        <mxCell id="ai" value="&lt;b&gt;Python AI Service&lt;/b&gt;&#160;:8000&#160;&#183;&#160;FastAPI&lt;br&gt;&lt;i&gt;ai-service-python.flycast — NO public IP&lt;/i&gt;&lt;br&gt;&lt;br&gt;Routes: /translate · /translate/batch · /health · /stats&lt;br&gt;&lt;br&gt;&lt;b&gt;translate_one():&lt;/b&gt; L1 → L2 → LLM → write both&lt;br&gt;&lt;b&gt;batch:&lt;/b&gt; bounded concurrency (asyncio.Semaphore)&lt;br&gt;&lt;br&gt;lib/llm.py&#160;&#160;·&#160;&#160;lib/cache.py&#160;&#160;·&#160;&#160;lib/logger.py&lt;br&gt;&lt;b&gt;holds the provider API key&lt;/b&gt;&#160;·&#160;fail-loud on LLM error → 502" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="545" y="390" width="720" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ailog" value="📄 ai-service.log&lt;br&gt;&lt;i&gt;cached · latencyMs · chars · requestId — same id greppable across both services&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="545" y="590" width="720" height="50" as="geometry" />
        </mxCell>

        <!-- ===== CACHE TIERS ===== -->
        <mxCell id="l1" value="&lt;b&gt;L1 — in-memory dict&lt;/b&gt;&lt;br&gt;instant · per-process&lt;br&gt;lost on restart&lt;br&gt;&lt;i&gt;checked first&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="690" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l2label" value="&lt;b&gt;L2 — persistent tier&lt;/b&gt; (pluggable via CACHE_BACKEND — pick ONE)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;fontColor=#8a6d00;" vertex="1" parent="1">
          <mxGeometry x="800" y="655" width="470" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sqlite" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;translations.db&lt;br&gt;&lt;i&gt;default · local file&lt;br&gt;survives restart&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="690" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="redis" value="&lt;b&gt;Upstash Redis&lt;/b&gt;&lt;br&gt;CACHE_BACKEND=redis&lt;br&gt;&lt;i&gt;shared L2 across regions&lt;br&gt;fra primary + iad replica&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="690" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cachekey" value="cache key = sha256(model :: target :: text)&lt;br&gt;→ swapping model/lang = clean miss, never stale" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#8a6d00;" vertex="1" parent="1">
          <mxGeometry x="820" y="810" width="420" height="40" as="geometry" />
        </mxCell>

        <!-- ===== EXTERNAL LLM ===== -->
        <mxCell id="llm" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenRouter (default)&lt;br&gt;anthropic/claude-sonnet-4.6&lt;br&gt;&lt;br&gt;&lt;i&gt;OpenAI-compatible client;&lt;br&gt;swap to vLLM self-hosted&lt;br&gt;via LLM_PROVIDER + MODEL&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1375" y="400" width="175" height="180" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->
        <mxCell id="e1" value="① POST /translate[/batch]&lt;br&gt;HTTPS · CORS · public Anycast" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.5;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" edge="1" parent="1" source="widget" target="gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="ext" target="gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="② proxy → http://ai-service-python.flycast&lt;br&gt;+ x-request-id · private 6PN, plain HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.5;strokeColor=#82b366;fontColor=#4a7a3a;fontSize=11;fontStyle=1;" edge="1" parent="1" source="gw" target="ai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3a" value="③ check L1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="ai" target="l1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3b" value="③ miss → L2 get / set" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="ai" target="sqlite">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="ai" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="④ on full miss: LLM call&lt;br&gt;HTTPS + API key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#9673a6;fontSize=11;fontStyle=1;" edge="1" parent="1" source="ai" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== LEGEND ===== -->
        <mxCell id="legend" value="&lt;b&gt;Request path&lt;/b&gt;&#160;&#160;① browser widget → gateway&#160;&#160;②&#160;gateway → AI service (Flycast)&#160;&#160;③&#160;cache: L1 memory then L2 (SQLite | Redis)&#160;&#160;④&#160;on a full miss only, one LLM round-trip.&#160;&#160;&#160;A cache hit skips ④ entirely — that&#39;s the latency + cost win.&lt;br&gt;&lt;b&gt;Why two services?&lt;/b&gt;&#160;&#160;edge concerns (CORS, validation, rate-limit, logging) live on the public gateway; the LLM + cache + API key live on the private AI service. Each deploys &amp;amp; fails independently; the key never sits on an internet-facing box." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1520" height="44" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
